# Normalize line endings to LF in the repository.
* text=auto

# Windows batch scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must keep LF.
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.pdf binary
*.ttf binary
*.otf binary
*.phvika binary
